{
  "name": "icon-tree-animate",
  "version": "0.2.6",
  "description": "Offline-ready React animated icon library with bundled Lottie icons, runtime recoloring, and static, loop, click, and hover modes.",
  "keywords": [
    "react",
    "icon",
    "icons",
    "animated-icons",
    "lottie",
    "lottie-icons",
    "icon-library",
    "offline",
    "recolorable-icons"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icon-entries/*.d.mts",
      "import": "./dist/icon-entries/*.mjs",
      "require": "./dist/icons/*.cjs"
    }
  },
  "bin": {
    "icontree": "scripts/search-icons.js"
  },
  "scripts": {
    "generate-registry": "node scripts/generate-registry.js ./src/icons",
    "build": "npm run generate-registry && tsup && node scripts/generate-cjs-icons.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "lottie-react": "^2.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "scripts"
  ]
}
